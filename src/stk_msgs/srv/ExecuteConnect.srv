# Deliberate escape hatch: send a raw Connect command string and return the
# raw response. Bypasses all typed message validation -- use only for
# capability not yet wrapped by a typed service, and treat the response as
# untrusted text the caller must parse. Every call is logged at WARNING
# level by interfaces/ros_services.py.

string command
float64 timeout_s   # 0.0 => use backend default
---
bool success
string raw_response
bool was_nack
