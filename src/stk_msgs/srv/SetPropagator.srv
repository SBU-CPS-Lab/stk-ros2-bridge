# Switches a satellite's propagator. Setting REALTIME activates the
# real-time orbit propagator that PositionCommand.msg feeds via
# SetPosition. It does not change attitude: core/actuation.py activates the
# real-time attitude profile (`SetAttitude Standard`) when the first
# AttitudeCommand for an object arrives. Switching to REALTIME discards
# any analytic ephemeris the object had.

string object_path

uint8 TWO_BODY = 0
uint8 J4_PERTURBATION = 1
uint8 HPOP = 2
uint8 REALTIME = 3
uint8 EXTERNAL = 4
uint8 propagator_type

float64 realtime_look_ahead_s    # valid if propagator_type == REALTIME
float64 realtime_look_behind_s   # valid if propagator_type == REALTIME
string external_ephemeris_path    # valid if propagator_type == EXTERNAL
---
bool success
string message
