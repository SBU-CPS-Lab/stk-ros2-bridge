# Explicit single-step request, valid only in LOCKSTEP mode. Useful for
# manual stepping from a MATLAB script or a test harness (with
# time.auto_step disabled). See docs/bridge/time_synchronization.md.

float64 step_s   # 0.0 => use the configured default step from bridge_params.yaml
---
bool success
string message
builtin_interfaces/Time new_sim_time
uint32 step_index
